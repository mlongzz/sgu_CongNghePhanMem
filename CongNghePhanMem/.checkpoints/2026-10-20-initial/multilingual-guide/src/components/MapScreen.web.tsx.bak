import React, { useState } from "react";
import {
  ActivityIndicator,
  Linking,
  Pressable,
  SafeAreaView,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { router } from "expo-router";

import GoogleMap from "../admin/GoogleMap";
import AutoGuideControl from "./AutoGuideControl";
import { C } from "../theme/colors";
import { useApp } from "../context/AppContext";
import { distanceKm } from "../services/nearby";

const RADII = [1, 3, 5, 10, 20];

export default function MapScreen() {
  const {
    places,
    location,
    radiusKm,
    setRadiusKm,
    refreshNearby,
    loadingPlaces,
    placesError,
    source,
  } = useApp();

  const [selectedId, setSelectedId] = useState<string | null>(null);

  // Dia diem dang duoc nguoi dung chon.
  const selected = selectedId
    ? (places.find((p) => p.id === selectedId) ?? null)
    : null;

  // Uu tien dia diem duoc chon, sau do GPS,
  // cuoi cung la POI dau tien neu chua co GPS.
  const mapPoint = selected ?? location ?? places[0] ?? null;

  const showingUserLocation = Boolean(location && !selected);

  // Lay GPS moi va dua ban do ve vi tri nguoi dung.
  const handleLocate = async () => {
    setSelectedId(null);
    await refreshNearby();
  };

  const handleSelectPlace = (id: string) => {
    setSelectedId(id);
  };

  const handleShowMyLocation = () => {
    setSelectedId(null);
  };

  const mapTitle = selected
    ? `Dia diem: ${selected.title}`
    : showingUserLocation
      ? "Vị trí hiện tại của bạn"
      : mapPoint
        ? "Bản đồ địa điểm"
        : "Chưa có vị trí để hiển thị";

  return (
    <SafeAreaView style={s.safe}>
      <ScrollView contentContainerStyle={s.page}>
        <Text style={s.eyebrow}>KHÁM PHÁ THEO VỊ TRÍ</Text>
        <Text style={s.title}>Địa danh quanh bạn</Text>
        <Text style={s.text}>
          Xác định vị trí GPS, xem bản đồ và khám phá các địa điểm du lịch xung
          quanh.
        </Text>

        <View style={s.card}>
          <Text style={s.label}>Bán kính tìm kiếm</Text>

          <View style={s.radii}>
            {RADII.map((km) => (
              <Pressable
                key={km}
                onPress={() => {
                  setSelectedId(null);
                  setRadiusKm(km);
                }}
                style={[s.radius, radiusKm === km && s.active]}
              >
                <Text
                  style={{
                    color: radiusKm === km ? "#fff" : C.primary,
                    fontWeight: "800",
                  }}
                >
                  {km} km
                </Text>
              </Pressable>
            ))}
          </View>

          <Pressable
            disabled={loadingPlaces}
            onPress={() => void handleLocate()}
            style={s.button}
          >
            {loadingPlaces ? (
              <ActivityIndicator color="#fff" />
            ) : (
              <Ionicons name="locate" color="#fff" size={18} />
            )}

            <Text style={s.buttonText}>
              {loadingPlaces ? "Đang lấy GPS..." : "Dùng GPS và tìm địa danh"}
            </Text>
          </Pressable>

          {location ? (
            <View style={s.statusRow}>
              <Ionicons name="checkmark-circle" size={17} color={C.primary} />
              <Text style={s.statusText}>
                Đã xác định vị trí. Có thể xem trên bản đồ.
              </Text>
            </View>
          ) : (
            <Text style={s.small}>
              Chưa xác định GPS. Nhấn nút ở trên để bắt đầu.
            </Text>
          )}

          {placesError ? <Text style={s.error}>{placesError}</Text> : null}

          <Text style={s.small}>
            Kết quả: {places.length} địa điểm · nguồn:{" "}
            {source === "live"
              ? "Dữ liệu trực tiếp"
              : "Chưa có dữ liệu trực tiếp"}
          </Text>
        </View>

        <AutoGuideControl />

        {/* Ban do Web */}
        <View style={s.card}>
          <View style={s.mapHeader}>
            <Text style={s.mapTitle}>{mapTitle}</Text>

            {location && selected ? (
              <Pressable
                accessibilityLabel="Xem vị trí của tôi"
                onPress={handleShowMyLocation}
                style={s.myLocationButton}
              >
                <Ionicons name="locate" size={16} color="#fff" />
                <Text style={s.myLocationText}>Vị trí của tôi</Text>
              </Pressable>
            ) : null}
          </View>

          {mapPoint ? (
            <GoogleMap
              key={`${mapPoint.latitude},${mapPoint.longitude}`}
              latitude={mapPoint.latitude}
              longitude={mapPoint.longitude}
            />
          ) : (
            <View style={s.mapEmpty}>
              <Ionicons name="location-outline" size={30} color={C.primary} />
              <Text style={s.small}>
                Nhấn "Dùng GPS và tìm địa danh" để hiển thị vị trí.
              </Text>
            </View>
          )}

          {showingUserLocation ? (
            <Text style={s.mapHint}>
              Marker đang hiển thị vị trí GPS ước lượng của bạn.
            </Text>
          ) : selected ? (
            <Text style={s.mapHint}>
              Đang xem địa điểm: {selected.title}. Nhấn "Vị trí của tôi" để quay
              lại GPS.
            </Text>
          ) : (
            <Text style={s.mapHint}>
              Hãy bật GPS để bản đồ hiển thị vị trí của bạn.
            </Text>
          )}
        </View>

        <Text style={s.label}>Các địa điểm tìm được</Text>

        {places.map((p) => (
          <View key={p.id} style={s.place}>
            <View style={{ flex: 1 }}>
              <Text style={s.placeTitle}>{p.title}</Text>

              <Text style={s.small}>
                {p.category} ·{" "}
                {location
                  ? `${distanceKm(location, p).toFixed(1)} km`
                  : "Chưa xác định GPS"}
              </Text>
            </View>

            <Pressable
              accessibilityLabel={`Chi tiết ${p.title}`}
              onPress={() => router.push(`/place/${p.id}` as never)}
              style={s.round}
            >
              <Ionicons name="book-outline" size={19} color={C.primary} />
            </Pressable>

            <Pressable
              accessibilityLabel={`Xem bản đồ ${p.title}`}
              onPress={() => handleSelectPlace(p.id)}
              style={s.round}
            >
              <Ionicons name="locate-outline" size={19} color={C.primary} />
            </Pressable>

            <Pressable
              accessibilityLabel={`Mở Google Maps ${p.title}`}
              onPress={() =>
                void Linking.openURL(
                  "https://www.google.com/maps/search/?api=1&query=" +
                    encodeURIComponent(`${p.latitude},${p.longitude}`),
                )
              }
              style={s.round}
            >
              <Ionicons name="map-outline" size={19} color={C.primary} />
            </Pressable>
          </View>
        ))}

        {source === "live" ? (
          <Text style={s.credit}>© OpenStreetMap contributors (ODbL)</Text>
        ) : null}
      </ScrollView>
    </SafeAreaView>
  );
}

const s = StyleSheet.create({
  safe: {
    flex: 1,
    backgroundColor: C.paper,
  },
  page: {
    padding: 22,
    paddingBottom: 100,
  },
  eyebrow: {
    fontSize: 10,
    color: C.primary,
    fontWeight: "900",
    letterSpacing: 2,
  },
  title: {
    fontSize: 26,
    fontWeight: "900",
    color: C.ink,
    marginTop: 9,
    marginBottom: 10,
  },
  text: {
    fontSize: 13,
    lineHeight: 22,
    color: C.muted,
    marginBottom: 16,
  },
  card: {
    backgroundColor: C.white,
    borderRadius: 20,
    padding: 17,
    borderWidth: 1,
    borderColor: C.border,
    marginBottom: 20,
  },
  label: {
    fontWeight: "900",
    color: C.ink,
    marginBottom: 13,
  },
  radii: {
    flexDirection: "row",
    flexWrap: "wrap",
    gap: 8,
    marginBottom: 18,
  },
  radius: {
    backgroundColor: C.primarySoft,
    padding: 12,
    borderRadius: 15,
  },
  active: {
    backgroundColor: C.primary,
  },
  button: {
    backgroundColor: C.primary,
    flexDirection: "row",
    gap: 10,
    alignItems: "center",
    justifyContent: "center",
    borderRadius: 13,
    padding: 15,
  },
  buttonText: {
    color: "#fff",
    fontWeight: "900",
  },
  statusRow: {
    flexDirection: "row",
    alignItems: "center",
    gap: 7,
    marginTop: 13,
  },
  statusText: {
    color: C.primary,
    fontSize: 12,
    fontWeight: "700",
    flex: 1,
  },
  small: {
    fontSize: 11,
    color: C.muted,
    marginTop: 7,
  },
  error: {
    color: C.danger,
    fontSize: 12,
    lineHeight: 20,
    marginTop: 12,
  },
  mapHeader: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
    gap: 8,
    marginBottom: 12,
    flexWrap: "wrap",
  },
  mapTitle: {
    color: C.ink,
    fontSize: 15,
    fontWeight: "900",
    flexShrink: 1,
  },
  myLocationButton: {
    backgroundColor: C.primary,
    borderRadius: 10,
    paddingHorizontal: 11,
    paddingVertical: 9,
    flexDirection: "row",
    alignItems: "center",
    gap: 5,
  },
  myLocationText: {
    fontSize: 11,
    fontWeight: "800",
    color: "#fff",
  },
  mapHint: {
    color: C.muted,
    fontSize: 11,
    marginTop: 10,
    lineHeight: 18,
  },
  mapEmpty: {
    minHeight: 200,
    alignItems: "center",
    justifyContent: "center",
    backgroundColor: C.primarySoft,
    borderRadius: 14,
    padding: 20,
    gap: 10,
  },
  place: {
    flexDirection: "row",
    alignItems: "center",
    gap: 10,
    padding: 13,
    borderWidth: 1,
    borderColor: C.border,
    borderRadius: 14,
    backgroundColor: C.white,
    marginBottom: 10,
  },
  placeTitle: {
    color: C.ink,
    fontWeight: "900",
    fontSize: 13,
  },
  round: {
    backgroundColor: C.primarySoft,
    borderRadius: 12,
    padding: 12,
  },
  credit: {
    textAlign: "center",
    fontSize: 10,
    color: C.muted,
    marginTop: 16,
  },
});
