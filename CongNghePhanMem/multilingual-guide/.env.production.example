# Copy to .env.production.local and replace with the real Render HTTPS URL.
# This example hostname is deliberately rejected by the production build guard.
EXPO_PUBLIC_API_URL=https://your-api.example.invalid
EXPO_PUBLIC_ENABLE_DIAGNOSTICS=0
# Never add database URLs, JWT secrets, Cloudflare tokens or R2 keys here.

# Optional browser-only MapTiler key: restrict Allowed HTTP Origins to your actual frontend domains.
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_MAPTILER_STYLE=streets-v4
