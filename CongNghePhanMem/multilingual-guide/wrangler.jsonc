{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multilingual-guide",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "upload_source_maps": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/", "/map", "/map/", "/login", "/login/", "/register", "/register/",
      "/admin", "/admin/", "/journeys", "/journeys/", "/saved", "/saved/",
      "/profile", "/profile/", "/history", "/history/", "/account", "/account/", "/place/*"
    ]
  },
  "observability": { "enabled": false }
}
