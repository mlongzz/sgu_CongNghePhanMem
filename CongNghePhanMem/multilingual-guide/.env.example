# Optional backend URL override.
# Required: the API host must be reachable from the browser or phone.
# For a physical phone, keep the phone and computer on the same Wi-Fi network.
# On a phone, replace 127.0.0.1 below with your computer LAN address.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_TTS_RATE=0.86
EXPO_PUBLIC_TTS_PITCH=1
# Keep developer diagnostics out of release builds. E2E explicitly enables it.
EXPO_PUBLIC_ENABLE_DIAGNOSTICS=0
