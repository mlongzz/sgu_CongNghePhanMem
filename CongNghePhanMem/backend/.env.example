DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/multilingual_guide
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Shared database-backed limits per five-minute window. Real client IP comes from the server request.
AUTH_LOGIN_LIMIT=12
AUTH_IP_LOGIN_LIMIT=120
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000
# Web queries /osm/nearby here; only FastAPI calls the fixed Overpass providers.
# Keep the exact Expo origin (including its port) in ALLOWED_ORIGINS.
# Dev only: accept any private-LAN origin so a phone on the same Wi-Fi works after network changes.
# ALLOW_LAN_ORIGINS=true
# Set trusted database user IDs, for example: ADMIN_USER_IDS=1,4
ADMIN_USER_IDS=
# Optional LibreTranslate configuration
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
# Optional absolute path; default backend/uploads. Persist this folder in containers.
UPLOAD_DIR=
# Map requests read a local snapshot; no Overpass request on GPS/map open.
# Persist this path in deployments. Optional sync is a separate, explicitly enabled job.
OSM_CACHE_PATH=

APP_ENV=development
MEDIA_STORAGE_BACKEND=local
# Production requires durable image storage, not Render Free local uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# R2 production alternative. Server-only values; never EXPO_PUBLIC_.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
PRESENCE_RETENTION_DAYS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Local file snapshots for development; production defaults to postgres (existing internal JSON store).
OSM_SNAPSHOT_STORAGE=local
# Optional: Google Maps ratings/reviews on place pages (Places API "New"; server-side only, billed by Google).
# GOOGLE_MAPS_API_KEY=
