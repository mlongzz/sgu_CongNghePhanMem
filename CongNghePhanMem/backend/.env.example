DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/multilingual_guide
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000
# Web queries /osm/nearby here; only FastAPI calls the fixed Overpass providers.
# Keep the exact Expo origin (including its port) in ALLOWED_ORIGINS.
# Set trusted database user IDs, for example: ADMIN_USER_IDS=1,4
ADMIN_USER_IDS=
# Optional LibreTranslate configuration
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
# Optional absolute path; default backend/uploads. Persist this folder in containers.
UPLOAD_DIR=
# Map requests read a local snapshot; no Overpass request on GPS/map open.
# Persist this path in deployments. Optional sync is a separate, explicitly enabled job.
OSM_CACHE_PATH=
